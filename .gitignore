# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# EAS (local build output / credentials — never commit signing secrets)
.easignore
credentials.json
*.keystore

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug / logs
npm-debug.*
yarn-debug.*
yarn-error.*
pnpm-debug.*
*.log
logs/

# test coverage
coverage/

# macOS
.DS_Store
*.pem

# Windows
Thumbs.db
desktop.ini

# editors
.vscode/
.idea/
*.swp

# local env files
.env*.local
.env
scripts/.env

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Python (scripts/generate_audio.py cache)
scripts/__pycache__/
*.pyc
